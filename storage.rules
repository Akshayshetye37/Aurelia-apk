rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function member(ownerId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/owners/$(ownerId)/members/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/owners/$(ownerId)/members/$(request.auth.uid)).data.status == "active";
    }
    function canWrite(ownerId) {
      return member(ownerId) &&
        firestore.get(/databases/(default)/documents/owners/$(ownerId)/members/$(request.auth.uid)).data.role in ["owner", "admin", "manager"];
    }
    match /owners/{ownerId}/{path=**} {
      allow read: if member(ownerId);
      allow create, update: if canWrite(ownerId) && request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches("image/.*|application/pdf|text/plain") &&
        (request.resource.metadata == null || !("ownerId" in request.resource.metadata) ||
          request.resource.metadata.ownerId == ownerId);
      allow delete: if canWrite(ownerId);
    }
    match /{path=**} { allow read, write: if false; }
  }
}
