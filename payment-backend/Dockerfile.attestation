FROM gradle:8.10-jdk21 AS build
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch v0.4 https://github.com/android/keyattestation.git /opt/keyattestation \
    && test "$(git -C /opt/keyattestation rev-parse HEAD)" = "621149c4ebaeeea844d6f43098687c73c4d370a3"
RUN chown -R gradle:gradle /opt/keyattestation
COPY --chown=gradle:gradle payment-backend/attestation-verifier /opt/aurelia-attestation-verifier
USER gradle
WORKDIR /opt/aurelia-attestation-verifier
RUN gradle --no-daemon shadowJar

FROM eclipse-temurin:21-jre-jammy
ENV ATTESTATION_BIND_HOST=0.0.0.0
ENV PORT=8080
WORKDIR /app
COPY --from=build /opt/aurelia-attestation-verifier/build/libs/aurelia-attestation-verifier.jar /app/verifier.jar
USER 10001
EXPOSE 8080
CMD ["java", "--add-modules", "jdk.httpserver", "-jar", "/app/verifier.jar"]
