# Copy to .env and replace every placeholder before starting.
PORT=8085
# Generate independent values with: openssl rand -hex 32
GATEWAY_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SESSION_TOKEN_PEPPER=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
# One-time first-owner enrollment token; generate independently and keep offline.
OWNER_SETUP_TOKEN=REPLACE_WITH_ANOTHER_INDEPENDENT_64_HEX_CHARACTERS
# Hostname/IP used by the Android device to reach Caddy; certificate SAN is issued for this name.
AURELIA_LAN_HOSTNAME=payments.local
# Exact ORIGIN of the PMS WebView, not the backend URL. Capacitor androidScheme=https uses https://localhost.
# Add other exact HTTPS origins only if you intentionally use a browser-hosted PMS.
AURELIA_OWNER_ORIGINS=https://localhost
TRUST_PROXY_HOPS=1
DATABASE_PATH=/data/aurelia-payments.sqlite

# Unique property identifier for this owner-controlled LAN appliance.
AURELIA_PROPERTY_ID=REPLACE_WITH_PROPERTY_IDENTIFIER
# Attestation identity of the app that creates the device key.
# Set the SHA-256 digest of the APK signing certificate (64 hex characters).
ATTESTATION_APP_PACKAGE=com.aurelia.pms
ATTESTATION_APP_MIN_VERSION=1
ATTESTATION_APP_SIGNER_SHA256=REPLACE_WITH_64_HEX_CERTIFICATE_DIGEST
