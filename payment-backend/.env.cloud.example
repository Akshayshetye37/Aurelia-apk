# Cloud Run / managed runtime configuration example.
# Use workload identity / Application Default Credentials; do not set a service-account key.
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_GCP_PROJECT_ID
# Comma-separated exact HTTPS origins for the Aurelia client.
AURELIA_OWNER_ORIGINS=https://localhost
# Set these only when deployed behind one trusted HTTPS ingress that overwrites X-Forwarded-Proto.
AURELIA_HTTPS_TERMINATION=trusted-proxy
AURELIA_TRUST_PROXY_HOPS=1
PORT=8080
